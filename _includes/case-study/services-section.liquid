<section class="section section--accent">
  <div class="container">
    {% if page.role %}
      <div class="role-card u-mb-400">
        <span class="role-card__label">My role</span>
        <p class="role-card__text">{{ page.role }}</p>
      </div>
    {% endif %}
    <h2 class="u-mb-300">Services</h2>
    <div class="flex flex--column">
      {% for service in page.services %}
        {% include case-study/service-card.liquid %}
      {% endfor %}
    </div>
  </div>
</section>